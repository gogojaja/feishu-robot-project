<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.feishu.opencode-serve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/opencode</string>
        <string>serve</string>
        <string>--port</string>
        <string>5102</string>
        <string>--hostname</string>
        <string>127.0.0.1</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/KINGSTON120G/feishu-robot-project</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/gogo</string>
        <key>OPENCODE_DB</key>
        <string>/Volumes/KINGSTON120G/feishu-robot-project/var/opencode.db</string>
        <key>OPENCODE_SERVER_PASSWORD</key>
        <string></string>
        <key>OPENCODE_SERVER_USERNAME</key>
        <string></string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Volumes/KINGSTON120G/feishu-robot-project/opencode_server.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/KINGSTON120G/feishu-robot-project/opencode_server.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.feishu.opencode-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Volumes/KINGSTON120G/feishu-robot-project/src/feishu_integration.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/KINGSTON120G/feishu-robot-project</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/gogo</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Volumes/KINGSTON120G/feishu-robot-project/feishu_bot.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/KINGSTON120G/feishu-robot-project/feishu_bot.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
